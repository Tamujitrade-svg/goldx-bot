# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here          # Personal or channel ID

# ─── MetaTrader 5 ─────────────────────────────────────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server               # e.g. MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ─── News API ─────────────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key               # https://newsapi.org
GNEWS_API_KEY=your_gnews_key               # https://gnews.io

# ─── Twitter / X API v2 ───────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# ─── Anthropic (LLM Interpretation) ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key   # https://console.anthropic.com

# ─── Trading Parameters ───────────────────────────────────────────────────────
SYMBOL=XAUUSD
TIMEFRAME=M15                               # M1 M5 M15 M30 H1 H4 D1
LOT_SIZE=0.01
MAX_RISK_PERCENT=1.0                        # Max % of balance per trade
SL_PIPS=200
TP_PIPS=400
MAX_DAILY_TRADES=5
MIN_SCORE_TO_TRADE=70                       # 0-100: minimum global score to open trade

# ─── Auto-Trade Mode ──────────────────────────────────────────────────────────
AUTO_TRADE=false                            # true = auto execute on MT5 | false = alerts only

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/goldx.log
